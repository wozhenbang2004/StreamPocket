<resources>
    <style name="PocketSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/pocket_sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/pocket_sheet_exit</item>
    </style>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#292929</item>
        <item name="android:colorControlNormal">#6D6D6D</item>
        <item name="android:colorControlActivated">#292929</item>
        <item name="android:colorButtonNormal">#FFFFFF</item>
        <item name="android:colorBackground">#F7F7F7</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F7F7</item>
        <item name="android:navigationBarColor">#F7F7F7</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowBackground">#F7F7F7</item>
        <item name="android:alertDialogTheme">@style/WhiteDialogTheme</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
    <style name="LightAppTheme" parent="BaseAppTheme" />
    <style name="WhiteDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#292929</item>
        <item name="android:colorControlNormal">#6D6D6D</item>
        <item name="android:colorControlActivated">#292929</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>
        <item name="android:windowBackground">@drawable/white_dialog_background</item>
    </style>
    <style name="DarkAppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#F0F0F0</item>
        <item name="android:colorControlNormal">#AAAAAA</item>
        <item name="android:colorControlActivated">#F0F0F0</item>
        <item name="android:colorButtonNormal">#202020</item>
        <item name="android:colorBackground">#141414</item>
        <item name="android:colorBackgroundFloating">#202020</item>
        <item name="android:windowBackground">#141414</item>
        <item name="android:statusBarColor">#141414</item>
        <item name="android:navigationBarColor">#141414</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/DarkDialogTheme</item>
    </style>
    <style name="DarkDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#F0F0F0</item>
        <item name="android:colorControlNormal">#AAAAAA</item>
        <item name="android:colorControlActivated">#F0F0F0</item>
        <item name="android:colorBackground">#202020</item>
        <item name="android:colorBackgroundFloating">#202020</item>
        <item name="android:windowBackground">@drawable/dark_dialog_background</item>
    </style>
</resources>
